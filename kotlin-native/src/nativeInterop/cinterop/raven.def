# Kotlin/Native binding of Raven, generated by cinterop from the C headers.
# (Raven ships no Kotlin binding: cinterop reads Raven.h directly.)
headers = Raven.h
headerFilter = Raven.h raven/*
package = raven
staticLibraries = libraven.a
# system import libraries the static library needs (see rust/build.rs)
# (libravenuuid.a: the libuuid of Debian's MinGW-w64, which has the UI Automation GUIDs)
linkerOpts = -L/opt/raven/static -lravenuuid -luser32 -lgdi32 -lshell32 -lcomdlg32 -lole32 -loleaut32 -ladvapi32 -lwinhttp
